<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    ADB (Android SDK Platform-Tools) exe'nin içine gömülür. Sistemde adb bulunamazsa
    çalışma anında %LOCALAPPDATA%\Fernien\platform-tools altına çıkarılır (bkz. Providers/Adb/EmbeddedAdb.cs).
  -->
  <ItemGroup>
    <EmbeddedResource Include="ThirdParty\platform-tools\*" LogicalName="adb/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
